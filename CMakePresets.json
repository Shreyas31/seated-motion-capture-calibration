{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "BUILD_TESTING": "ON",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": ""
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "x64-debug",
            "displayName": "x64 Debug",
            "inherits": "windows-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "x64-opensim-relwithdebinfo",
            "displayName": "OpenSim x64 RelWithDebInfo (Visual Studio 2026)",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "toolset": "v143",
            "binaryDir": "${sourceDir}/out/build/x64-opensim-relwithdebinfo",
            "cacheVariables": {
                "BUILD_TESTING": "ON",
                "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo",
                "OPENSIM_INSTALL_DIR": "$env{OPENSIM_HOME}",
                "BUILD_OPENSIM_COMPONENTS": "ON"
            }
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release",
            "inherits": "x64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "x86-debug",
            "displayName": "x86 Debug",
            "inherits": "windows-base",
            "architecture": {
                "value": "x86",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "x86-release",
            "displayName": "x86 Release",
            "inherits": "x86-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "BUILD_TESTING": "ON",
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "vendor": {
                "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
                    "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
                }
            }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "BUILD_TESTING": "ON",
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "vendor": {
                "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
                    "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
                }
            }
        }
    ],
    "buildPresets": [
        {
            "name": "x64-debug",
            "displayName": "Build x64 Debug",
            "configurePreset": "x64-debug"
        },
        {
            "name": "x64-release",
            "displayName": "Build x64 Release",
            "configurePreset": "x64-release"
        },
        {
            "name": "x64-opensim-relwithdebinfo",
            "displayName": "Build OpenSim x64 RelWithDebInfo",
            "configurePreset": "x64-opensim-relwithdebinfo",
            "configuration": "RelWithDebInfo"
        }
    ],
    "testPresets": [
        {
            "name": "x64-debug",
            "displayName": "Test x64 Debug",
            "configurePreset": "x64-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "x64-release",
            "displayName": "Test x64 Release",
            "configurePreset": "x64-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "x64-opensim-relwithdebinfo",
            "displayName": "Test OpenSim x64 RelWithDebInfo",
            "configurePreset": "x64-opensim-relwithdebinfo",
            "configuration": "RelWithDebInfo",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
